# Database
# Local Docker development database (used when SUPABASE_DB_URL is not set)
DATABASE_URL=postgresql://postgres:postgres@db:5432/smartroads

# Supabase
# Base project URL, as shown in Supabase Dashboard > Connect.
SUPABASE_URL=https://ajeldseedlhflyedyham.supabase.co
# REST endpoint for direct PostgREST calls.
SUPABASE_REST_URL=https://ajeldseedlhflyedyham.supabase.co/rest/v1
# Add the anon key only if the frontend will call Supabase directly.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side only. Do not use a NEXT_PUBLIC_ prefix or commit its real value.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Server-side Postgres connection string from Supabase: Connect > ORMs > SQLAlchemy.
# Do not commit the database password or service-role key.
# Example: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=

# Mapbox / Google Maps
MAPBOX_TOKEN=your_mapbox_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
AI_SERVICE_URL=http://localhost:8010/predict
SATELLITE_SERVICE_URL=http://localhost:8020/compare

# JWT
JWT_SECRET=replace_this_with_a_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDSeDxTjpOsATtOTha1-u33srK3PvO890s
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=road-ai-bd7ce.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=road-ai-bd7ce
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=road-ai-bd7ce.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=294982921318
NEXT_PUBLIC_FIREBASE_APP_ID=1:294982921318:web:4b026cc274e95ab6c491a7
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-51ZD886ZYK
# Backend only: download this from Firebase Console > Project settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=

